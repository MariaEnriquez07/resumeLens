/*
  ResumeLens Candidate Profile Language (RCPL)
  Context-free grammar implemented with textX.
  EBNF version and explanation: docs/stage4_grammar.md
*/

Resume:
    'resume' '{'
        candidate      = Candidate
        contact        = Contact
        education      = EducationSection?
        experience     = ExperienceSection?
        skills         = SkillsSection
        classification = ClassificationSection
    '}'
;

Candidate:
    'candidate' name=STRING ';'
;

/* ---------- contact information ---------- */

Contact:
    'contact' '{' items*=ContactItem '}'
;

ContactItem:
    EmailItem | PhoneItem | LinkItem
;

EmailItem:  'email' ':' value=EMAIL ';' ;
PhoneItem:  'phone' ':' value=PHONE ';' ;
LinkItem:   kind=LinkKind ':' value=URL ';' ;
LinkKind:   'linkedin' | 'github' | 'website' ;

/* ---------- education (repeated records) ---------- */

EducationSection:
    'education' '{' records+=Degree '}'
;

Degree:
    'degree' level=DegreeLevel title=STRING
        ('at' institution=STRING)?
        ('year' year=YEAR)? ';'
;

DegreeLevel:
    'TECHNICIAN' | 'TECHNOLOGIST' | 'BACHELOR' | 'MASTER' | 'PHD'
;

/* ---------- experience (repeated records) ---------- */

ExperienceSection:
    'experience' '{'
        ('total' 'years' ':' total=INT ';')?
        ('summary' ':' summary=STRING ';')?
        jobs*=Job
    '}'
;

Job:
    'job' role=STRING 'at' company=STRING
        'from' start=YEAR 'to' end=JobEnd ';'
;

JobEnd:
    YEAR | 'PRESENT'
;

/* ---------- normalized skills, grouped by category ---------- */

SkillsSection:
    'skills' '{' groups*=SkillGroup '}'
;

SkillGroup:
    category=Category ':' skills+=SKILL[','] ';'
;

Category:
    'LANGUAGES' | 'FRAMEWORKS' | 'DATABASES' | 'ML_DATA' | 'DEVOPS_CLOUD' | 'TOOLS'
;

/* ---------- result of the profile classification ---------- */

ClassificationSection:
    'classification' '{' results+=ProfileResult '}'
;

ProfileResult:
    'profile' profile=ProfileName 'is' status=Status
        'via' automaton=AutomatonKind
        ('sequence' ':' sequence+=SKILL[','])?
        ('missing' ':' missing+=STRING[','])? ';'
;

ProfileName:
    'FULL_STACK_DEVELOPER' | 'MACHINE_LEARNING_ENGINEER'
  | 'DEVOPS_ENGINEER'      | 'DATA_ANALYST'
;

Status:        'ACCEPTED' | 'REJECTED' ;
AutomatonKind: 'DFA' | 'NFA' | 'ENFA' ;

/* ---------- lexical rules (terminals) ---------- */

SKILL:  /[A-Z][A-Z0-9_]*/ ;
EMAIL:  /[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+/ ;
PHONE:  /\+?[0-9(][0-9 ()-]{5,}[0-9]/ ;
URL:    /https?:\/\/[^\s;"]+/ ;
YEAR:   /(19|20)[0-9]{2}\b/ ;

Comment: /\/\/.*$/ ;
